// Firestore Security Rules — portfolio project (portfolio-443a0).
//
// DEPLOY: copy this file's contents into the Firebase Console:
//   Build → Firestore Database → Rules → paste → Publish
//
// Or via CLI:
//   npx firebase-tools deploy --only firestore:rules
//
// SECURITY MODEL
// ──────────────
// These rules are the *only* thing between the public internet and
// your Firestore database. We use the standard Firebase pattern:
// the public Web SDK on the client writes directly to Firestore;
// the rules below enforce shape, type, and length validators.
//
// Default posture: DENY EVERYTHING. Each public form opens exactly
// one collection for create-only access with strict validators.
// Read / update / delete are denied for all public collections —
// that data is only inspected by you (the project owner) in the
// Firebase Console.
//
// Never relax these validators without thinking about abuse vectors.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Contact form submissions ─────────────────────────────────
    // Public can CREATE a strictly-shaped doc. Cannot read, update,
    // or delete from any client. You read submissions in the
    // Firebase Console.
    match /contactSubmissions/{id} {
      allow create: if
           request.resource.data.keys().hasOnly(['name','email','message','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.email.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Resume request lead capture (resumeRequests) was removed along
    // with ResumeForm — resume download is now a direct link, no
    // gated form/Firestore write. If a `resumeRequests` rule was
    // already published to the Firebase Console, remove it there too
    // (this file is only a reference; publishing is manual).

    // ── Chat widget global daily usage counter ───────────────────
    // Written exclusively by the Admin SDK (Route Handler at
    // /api/chat) via a server-side transaction — the Admin SDK
    // bypasses these rules entirely. This block exists only to keep
    // the deny-all posture for this collection explicit, matching
    // every other collection here. No client ever reads/writes
    // chatUsage, and no chat message content is ever stored here or
    // anywhere else server-side (conversations are ephemeral,
    // browser-only).
    match /chatUsage/{date} {
      allow read, write: if false;
    }

    // ── Catch-all: deny everything else ──────────────────────────
    // This MUST stay at the bottom. New collections need explicit
    // rules above this line.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
