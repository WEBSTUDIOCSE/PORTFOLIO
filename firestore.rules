// Firestore Security Rules — portfolio project (portfolio-443a0).
//
// DEPLOY: copy this file's contents into the Firebase Console:
//   Build → Firestore Database → Rules → paste → Publish
//
// Or via CLI:
//   npx firebase-tools deploy --only firestore:rules
//
// SECURITY MODEL
// ──────────────
// These rules are the *only* thing between the public internet and
// your Firestore database. We use the standard Firebase pattern:
// the public Web SDK on the client writes directly to Firestore;
// the rules below enforce shape, type, and length validators.
//
// Default posture: DENY EVERYTHING. Each public form opens exactly
// one collection for create-only access with strict validators.
// Read / update / delete are denied for all public collections —
// that data is only inspected by you (the project owner) in the
// Firebase Console.
//
// Never relax these validators without thinking about abuse vectors.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Contact form submissions ─────────────────────────────────
    // Public can CREATE a strictly-shaped doc. Cannot read, update,
    // or delete from any client. You read submissions in the
    // Firebase Console.
    match /contactSubmissions/{id} {
      allow create: if
           request.resource.data.keys().hasOnly(['name','email','message','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.email.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // ── Resume request lead capture ──────────────────────────────
    // Same shape as contactSubmissions but with role + company.
    match /resumeRequests/{id} {
      allow create: if
           request.resource.data.keys().hasOnly(['name','email','role','company','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.email.size() <= 200
        && request.resource.data.role is string
        && request.resource.data.role.size() > 0
        && request.resource.data.role.size() <= 200
        && request.resource.data.company is string
        && request.resource.data.company.size() > 0
        && request.resource.data.company.size() <= 200
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // ── Catch-all: deny everything else ──────────────────────────
    // This MUST stay at the bottom. New collections need explicit
    // rules above this line.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
